# Used by Vercel when the project root is the repository root.
# The same values live in frontend/.env for the case where the root is frontend/.
#
# Relative path -> same-origin with the Vite dev server and with Apache.
VITE_API_BASE_URL=/backend/api

# Where the Vite dev server forwards /backend requests to.
VITE_API_PROXY_TARGET=http://localhost:8000
