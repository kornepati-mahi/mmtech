# Relative path -> same-origin with the Vite dev server and with Apache.
# The Vite dev server proxies /backend to VITE_API_PROXY_TARGET (default http://localhost:8000).
VITE_API_BASE_URL=/backend/api

# Where the Vite dev server forwards /backend requests to.
VITE_API_PROXY_TARGET=http://localhost:8000

# To call the API on a different host instead, set an absolute URL here, e.g.
# VITE_API_BASE_URL=http://localhost:8000/backend/api
