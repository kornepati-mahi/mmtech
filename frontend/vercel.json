{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "if [ -f frontend/package.json ]; then cd frontend; fi; npm install",
  "buildCommand": "if [ -f frontend/package.json ]; then cd frontend; fi; npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": "https://YOUR-PHP-HOST.example.com/backend/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://YOUR-PHP-HOST.example.com/uploads/:path*"
    },
    {
      "source": "/((?!backend|uploads).*)",
      "destination": "/index.html"
    }
  ]
}
